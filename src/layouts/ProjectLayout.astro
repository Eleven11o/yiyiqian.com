---
import type { CollectionEntry } from "astro:content";
import BaseLayout from "./BaseLayout.astro";
import ChapterSynopsis from "../components/ChapterSynopsis.astro";
import DeepcoreContribution from "../components/DeepcoreContribution.astro";
import LegacyProjectStory from "../components/LegacyProjectStory.astro";
import MediaGallery from "../components/MediaGallery.astro";
import ProjectHero from "../components/ProjectHero.astro";
import ProjectLaurels from "../components/ProjectLaurels.astro";
import ProjectMetadata from "../components/ProjectMetadata.astro";
import ProjectNarrativeSection from "../components/ProjectNarrativeSection.astro";
import ProjectNavigation from "../components/ProjectNavigation.astro";
import ProjectRichStory from "../components/ProjectRichStory.astro";
import ProjectTeam from "../components/ProjectTeam.astro";
import ProjectTrailer from "../components/ProjectTrailer.astro";
import ProjectVideo from "../components/ProjectVideo.astro";
import ProductDesignStory from "../components/ProductDesignStory.astro";
import { deepcoreCopy } from "../data/deepcoreCopy";

interface Props {
  project: CollectionEntry<"projects">;
  previous?: CollectionEntry<"projects">;
  next?: CollectionEntry<"projects">;
}

const { project, previous, next } = Astro.props;
const { data } = project;
const pageTitle = `${data.title} — Yiyi Qian`;
---

<BaseLayout title={pageTitle} description={data.description} image={data.cover}>
  <article class:list={["project-case-study", `project-${project.id}`, { "legacy-project": data.legacyTheme }, data.legacyTheme && `legacy-theme-${data.legacyTheme.replace("wix-", "")}`]}>
    <ProjectHero project={project} />

    {data.legacyTheme ? (
      <LegacyProjectStory project={project} />
    ) : data.storyMode === "cultural-product" ? (
      <ProductDesignStory project={project} />
    ) : (
      <div class="project-body shell">
      <ProjectMetadata project={project} />

      <div class="project-story">
        {data.trailer && <ProjectTrailer video={data.trailer} />}

        {data.externalMedia && data.externalMedia.length > 0 && (
          <nav class="project-watch" aria-label="Project viewing links">
            {data.externalMedia.map((item) => (
              <a href={item.url} rel="noreferrer">
                <span class="section-kicker">Film screener</span>
                <strong class="project-watch-link-text">{item.label}</strong>
                {item.subtitle && <span class="project-watch-subtitle">{item.subtitle}</span>}
                <span class="project-watch-arrow" aria-hidden="true">↗</span>
              </a>
            ))}
          </nav>
        )}

        <ProjectNarrativeSection number="01" label="Project Overview" title="Project overview" titleZh={project.id === "deepcore" ? "项目概述" : undefined} compact>
          <p>{data.experience}</p>
          {project.id === "deepcore" && <p class="deepcore-zh" lang="zh-Hans">{deepcoreCopy.overview}</p>}
          {project.id === "resonance" && <p class="resonance-zh" lang="zh-Hans">《共·鸣》是一件探索共同在场与群体情感的音乐仪式交互装置。中心架鼓、四面屏幕、机械鼓槌、入座与敲击传感以及实时摄像映射，共同构成即时的视听与动作反馈，使观众围绕共同的节奏与注意中心，从旁观者转变为共同表演者。</p>}
          {data.officialRecord && (
            <p class="project-official-record">
              <span>{data.officialRecord.label}</span>
              <a href={data.officialRecord.url} rel="noreferrer">
                {data.officialRecord.detail}<span aria-hidden="true"> ↗</span>
              </a>
            </p>
          )}
        </ProjectNarrativeSection>

        {data.featuredVideo && <ProjectVideo video={data.featuredVideo} />}
        {data.storyMode && <ProjectRichStory project={project} />}

        {!data.storyMode && (
          <>

        {data.context && (
          project.id === "deepcore" ? (
            <section class="project-context-statement" aria-label="Historical context">
              <p>{data.context}</p>
              <p class="deepcore-zh" lang="zh-Hans">{deepcoreCopy.context}</p>
            </section>
          ) : (
            <ProjectNarrativeSection label="Context" title="Context and motivation" compact>
              <p>{data.context}</p>
            </ProjectNarrativeSection>
          )
        )}

        {data.gallery.length > 0 && <MediaGallery items={data.gallery.slice(0, 2)} />}

        {project.id === "deepcore" && <DeepcoreContribution />}
        {data.chapterSynopsis.length > 0 && <ChapterSynopsis chapters={data.chapterSynopsis} englishFirst={project.id === "deepcore"} />}

        {data.researchQuestion && (
          <ProjectNarrativeSection number="02" label="Research Question" title="Question emerging from practice" emphasis>
            <p>{data.researchQuestion}</p>
          </ProjectNarrativeSection>
        )}

        {data.creativeProcess && (
          <ProjectNarrativeSection number="03" label="Creative Process" title="Making and inquiry" compact>
            <p>{data.creativeProcess}</p>
          </ProjectNarrativeSection>
        )}

        {data.designProduction && (
          <ProjectNarrativeSection label="Design / Production" title="Design and production" compact>
            <p>{data.designProduction}</p>
          </ProjectNarrativeSection>
        )}

        {data.researchMethod && (
          <ProjectNarrativeSection label="Research Method" title="Method" compact>
            <p>{data.researchMethod}</p>
          </ProjectNarrativeSection>
        )}

        {data.productionPipeline && (
          <ProjectNarrativeSection label="Technical approach" title="Production pipeline" titleZh={project.id === "deepcore" ? "技术实现与制作流程" : undefined} compact>
            <p>{data.productionPipeline}</p>
            {project.id === "deepcore" && <p class="deepcore-zh" lang="zh-Hans">{deepcoreCopy.pipeline}</p>}
          </ProjectNarrativeSection>
        )}

        {data.reflection && (
          <ProjectNarrativeSection number="04" label="Reflection / Outcome" title="Reflection" compact>
            <p>{data.reflection}</p>
          </ProjectNarrativeSection>
        )}

        {data.outcome && (
          <ProjectNarrativeSection label="Outcome" title="Outcome" compact>
            <p>{data.outcome}</p>
          </ProjectNarrativeSection>
        )}
          </>
        )}

        {Boolean(data.exhibitions?.length || data.awards?.length || data.publications?.length || data.credits?.length || data.laurels.length || data.team.length) && (
          <section class="project-record" aria-labelledby="project-record-title">
            <p class="section-kicker">Project record</p>
            <h2 id="project-record-title">Credits and references</h2>
            <div class="record-grid">
              {data.exhibitions?.length && (
                <div>
                  <h3>Exhibitions</h3>
                  <ul>{data.exhibitions.map((item) => <li>{item}</li>)}</ul>
                </div>
              )}
              {data.awards?.length && (
                <div class="record-awards">
                  <h3>Awards / Selections</h3>
                  <ul>{data.awards.map((item) => <li>{item}</li>)}</ul>

                </div>
              )}
              {data.publications?.length && (
                <div>
                  <h3>Publications</h3>
                  <ul>{data.publications.map((item) => <li>{item}</li>)}</ul>
                </div>
              )}
              {data.credits?.length && (
                <div>
                  <h3>Credits</h3>
                  <ul>{data.credits.map((item) => <li>{item}</li>)}</ul>
                </div>
              )}
            </div>
            {data.laurels.length > 0 && <ProjectLaurels items={data.laurels} />}
            {data.gallery.length > 2 && (
              <div class="exhibition-documentation">
                <h3>Exhibition documentation</h3>
                <MediaGallery items={data.gallery.slice(2)} />
              </div>
            )}

            {data.team.length > 0 && <ProjectTeam items={data.team} />}
          </section>
        )}
        </div>
      </div>
    )}

    <ProjectNavigation previous={previous} next={next} />
  </article>
</BaseLayout>
