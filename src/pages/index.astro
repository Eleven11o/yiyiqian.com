---
import { getCollection, getEntry } from "astro:content";
import BaseLayout from "../layouts/BaseLayout.astro";
import ProjectPreview from "../components/ProjectPreview.astro";
import SectionHeading from "../components/SectionHeading.astro";

const home = await getEntry("pages", "home");
if (!home || home.data.pageType !== "home") throw new Error("Home page content is missing.");

const selectedProjectIds = ["deepcore", "resonance", "lishang-yeying"];
const allProjects = await getCollection("projects");
const projects = selectedProjectIds
  .map((id) => allProjects.find((project) => project.id === id))
  .filter((project): project is NonNullable<typeof project> => Boolean(project));
---

<BaseLayout>
  <section class="home-hero shell">
    <h1>{home.data.title}</h1>
    <div class="hero-positioning">
      <p class="hero-position">{home.data.position}</p>
      <p class="hero-practice">{home.data.practiceLine}</p>
    </div>
    <div class="hero-statement">
      <p>{home.data.researchStatement}</p>
    </div>

  </section>

  <section class="selected-works shell" aria-labelledby="selected-works-title">
    <SectionHeading id="selected-works-title" title="Selected works" linkHref="/works/" linkLabel="View all works" />
    <div class="selected-project-list">
      {projects.map((project, index) => <ProjectPreview project={project} index={index} eager={index === 0} />)}
    </div>
  </section>
</BaseLayout>
