---
import { getCollection } from "astro:content";
import BaseLayout from "../../layouts/BaseLayout.astro";
import ProjectPreview from "../../components/ProjectPreview.astro";

const categories = [
  { value: "Cinematic VR", label: "电影式虚拟现实 / Cinematic VR" },
  { value: "Interactive Media", label: "交互媒体 / Interactive Media" },
  { value: "Product Design", label: "产品设计 / Product Design" },

] as const;
const projects = (await getCollection("projects")).sort((a, b) => a.data.order - b.data.order);
---

<BaseLayout title="Works — Yiyi Qian" description="Cinematic VR and interactive media works by Yiyi Qian.">
  <header class="page-header shell">
    <p class="section-kicker">Archive</p>
    <h1>Works</h1>

  </header>

  <div class="works-archive shell">
    {categories.map((category) => {
      const categoryProjects = projects.filter((project) => project.data.category === category.value);
      return (
        <section
          class="archive-category"
          aria-labelledby={`category-${category.value.toLowerCase().replaceAll(" ", "-")}`}
        >
          <header>
            <h2 id={`category-${category.value.toLowerCase().replaceAll(" ", "-")}`}>{category.label}</h2>
            <p>{String(categoryProjects.length).padStart(2, "0")}</p>
          </header>
          {categoryProjects.length > 0 ? (
            <div class="archive-project-list">
              {categoryProjects.map((project, index) => <ProjectPreview project={project} index={index} />)}
            </div>
          ) : (
            <p class="empty-state">Future work in this category will appear here.</p>
          )}
        </section>
      );
    })}
  </div>
</BaseLayout>
