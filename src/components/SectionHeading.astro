---
interface Props {
  id?: string;
  eyebrow?: string;
  title: string;
  linkHref?: string;
  linkLabel?: string;
}

const { id, eyebrow, title, linkHref, linkLabel } = Astro.props;
---

<header class="section-heading">
  <div>
    {eyebrow && <p class="section-kicker">{eyebrow}</p>}
    <h2 id={id}>{title}</h2>
  </div>
  {linkHref && linkLabel && <a class="text-link" href={linkHref}>{linkLabel} →</a>}
</header>
